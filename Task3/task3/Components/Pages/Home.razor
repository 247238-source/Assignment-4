@page "/"
@rendermode InteractiveServer

<div class="container mt-4">
    <h3 class="mb-3 text-primary">Task 3: Interactive To-Do List</h3>

    <div class="row">
        <div class="col-md-6">
            <div class="card p-4 shadow-sm border-0 bg-light">
                <h5 class="card-title fw-bold text-secondary mb-3">Manage Your Daily Objectives</h5>

                <!-- Input Group to Add Task -->
                <div class="input-group mb-3 shadow-sm">
                    <input type="text" 
                           class="form-control form-control-lg border-2" 
                           @bind="newTaskDescription" 
                           @onkeyup="HandleKeyUp"
                           placeholder="What needs to be done?" />
                    <button class="btn btn-primary fw-bold px-4" @onclick="AddTask">Add Task</button>
                </div>

                <!-- Unordered To-Do List Elements -->
                @if (todoItems.Count == 0)
                {
                    <div class="p-3 text-center text-muted fst-italic border rounded bg-white">
                        Your list is empty! Add an item above to get started.
                    </div>
                }
                else
                {
                    <ul class="list-group shadow-sm">
                        @foreach (var item in todoItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-white border-start border-4 @(item.IsCompleted ? "border-success" : "border-warning")">
                                <div class="form-check m-0 d-flex align-items-center">
                                    <input class="form-check-input me-3 border-2" 
                                           type="checkbox" 
                                           @bind="item.IsCompleted" 
                                           id="@item.Id" />
                                    <label class="form-check-label fs-5 @(item.IsCompleted ? "text-decoration-line-through text-muted" : "fw-semibold text-dark")" 
                                           for="@item.Id">
                                        @item.Description
                                    </label>
                                </div>
                                <button class="btn btn-outline-danger btn-sm rounded-circle px-2" 
                                        @onclick="() => RemoveTask(item.Id)" 
                                        title="Delete Task">
                                    ✕
                                </button>
                            </li>
                        }
                    </ul>

                    <!-- Summary Stats Footer -->
                    <div class="d-flex justify-content-between align-items-center mt-3 px-2 text-secondary small fw-bold">
                        <span>Total Tasks: @todoItems.Count</span>
                        <span class="text-success">Completed: @todoItems.Count(t => t.IsCompleted)</span>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {
    // Local memory model for structure handling
    private class TodoItem
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Description { get; set; } = string.Empty;
        public bool IsCompleted { get; set; } = false;
    }

    private List<TodoItem> todoItems = new List<TodoItem>();
    private string newTaskDescription = "";

    private void AddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTaskDescription))
        {
            todoItems.Add(new TodoItem { Description = newTaskDescription.Trim() });
            newTaskDescription = ""; // Clear input after adding
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTask();
        }
    }

    private void RemoveTask(Guid id)
    {
        var itemToRemove = todoItems.FirstOrDefault(t => t.Id == id);
        if (itemToRemove != null)
        {
            todoItems.Remove(itemToRemove);
        }
    }
}