@page "/Registration"
@rendermode InteractiveServer
@using Assignment4.Models

<div class="container mt-4">
    <h3 class="mb-3 text-primary">Application 2: Secure Registration Form</h3>

    <div class="row">
        <div class="col-md-6">
            <div class="card p-4 shadow-sm border-0 bg-light">

                <EditForm Model="@registrationUser" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-secondary">First Name:</label>
                        <InputText class="form-control" @bind-Value="registrationUser.FirstName" placeholder="Enter first name" />
                        <ValidationMessage For="@(() => registrationUser.FirstName)" class="text-danger small mt-1" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-secondary">Last Name:</label>
                        <InputText class="form-control" @bind-Value="registrationUser.LastName" placeholder="Enter last name" />
                        <ValidationMessage For="@(() => registrationUser.LastName)" class="text-danger small mt-1" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-bold text-secondary">Email Address:</label>
                        <InputText class="form-control" @bind-Value="registrationUser.Email" placeholder="Enter email address" />
                        <ValidationMessage For="@(() => registrationUser.Email)" class="text-danger small mt-1" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold mt-2">Submit Registration</button>
                </EditForm>

                @if (isSubmissionSuccessful)
                {
                    <div class="alert alert-success border-0 shadow-sm mt-4">
                        <h5 class="fw-bold mb-1">Registration Complete!</h5>
                        <p class="mb-0 small">Account processed successfully for @registrationUser.FirstName @registrationUser.LastName (@registrationUser.Email).</p>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@code {
    private UserModel registrationUser = new UserModel();
    private bool isSubmissionSuccessful = false;

    private void HandleValidSubmit()
    {
        isSubmissionSuccessful = true;
    }
}