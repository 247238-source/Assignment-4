@inject task5.Services.AuthenticationStateService AuthService
@implements IDisposable

<div class="card p-3 shadow-sm text-center">
    <h4>Authentication Controls</h4>

    @if (AuthService.IsAuthenticated)
    {
        <button class="btn btn-danger w-100 mt-2" @onclick="AuthService.LogOut">Log Out</button>
    }
    else
    {
        <button class="btn btn-primary w-100 mt-2" @onclick="AuthService.LogIn">Log In</button>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
    }
}