@inject task6.Services.NotificationConfig Config

<div class="card p-3 shadow-sm border-primary">
    <h5 class="fw-bold text-primary">⚙️ Settings</h5>

    <div class="mb-3 mt-2">
        <label class="form-label fw-bold small">Number of Notifications:</label>
        <input type="number" class="form-control" @bind="Config.DefaultNumberOfNotifications" min="1" max="10" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold small">Display Style:</label>
        <select class="form-select" @bind="Config.NotificationStyle">
            <option value="Compact">Compact</option>
            <option value="Detailed">Detailed</option>
        </select>
    </div>

    <button class="btn btn-primary w-100 fw-bold" @onclick="UpdateConfig">Apply Settings</button>
</div>

@code {
    private void UpdateConfig()
    {
        Config.NotifyStateChanged();
    }
}